		"clsx": "^2.1.1",
		"cn": "^0.4.0",
		"eslint": "^10.12.0",
		"layerchart": "^2.5.1",
		"mode-watcher": "^1.1.0",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"runed": "^0.37.1",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.8.1",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tailwint": "^1.1.16",
		"tw-animate-css": "^1.4.0",
