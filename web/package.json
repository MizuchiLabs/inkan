{
	"name": "inkan",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"postbuild": "touch build/.gitkeep",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"shadup": "shadcn-svelte update --all",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint && eslint .",
		"lint:fix": "oxlint --fix && eslint . --fix && tailwint --fix"
	},
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource/zen-kaku-gothic-new": "^5.3.0"
	},
	"devDependencies": {
		"@hey-api/openapi-ts": "^0.99.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.52.0",
		"@shadcn/lint": "^0.2.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/language-server": "^0.16.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/svelte-query": "^6.3.1",
		"@typescript-eslint/parser": "^8.71.0",
		"@typescript/native": "npm:typescript@^7.0.2",
