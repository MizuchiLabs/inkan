{
	"components": {
		"schemas": {
			"CheckInputBody": {
				"additionalProperties": false,
				"properties": { "key": { "maxLength": 4096, "minLength": 1, "type": "string" } },
				"required": ["key"],
				"type": "object"
			},
			"CheckResult": {
				"additionalProperties": false,
				"properties": {
					"email": { "type": "string" },
					"expires_at": {
						"description": "Null for a perpetual key",
						"format": "date-time",
						"type": ["string", "null"]
					},
					"known": { "description": "Whether the license id is in the ledger", "type": "boolean" },
					"license_id": {
						"description": "Id signed into the key, empty for keys issued without one",
						"type": "string"
					},
					"meta": { "additionalProperties": { "type": "string" }, "type": "object" },
					"plan": { "type": "string" },
					"product_id": {
						"description": "Product the key prefix belongs to, null when unknown",
						"format": "int64",
						"type": ["integer", "null"]
					},
					"reason": { "description": "Why the key is invalid, empty otherwise", "type": "string" },
					"state": { "enum": ["valid", "expired", "invalid"], "type": "string" }
				},
				"required": [
					"state",
					"reason",
					"product_id",
					"license_id",
					"known",
					"plan",
					"email",
					"expires_at",
					"meta"
				],
				"type": "object"
			},
			"CreateLicenseInputBody": {
				"additionalProperties": false,
				"properties": {
					"customer": { "maxLength": 128, "type": "string" },
					"email": { "maxLength": 254, "type": "string" },
					"expires_at": {
						"description": "Leave out for a perpetual license",
						"format": "date-time",
						"type": "string"
					},
					"meta": {
						"additionalProperties": { "type": "string" },
						"description": "Extra claims signed into the key, keep them short",
						"type": "object"
					},
					"note": { "maxLength": 2000, "type": "string" },
					"plan": {
						"description": "Defaults to the product plan",
						"maxLength": 32,
						"type": "string"
					},
					"product_id": { "format": "int64", "type": "integer" }
				},
				"required": ["product_id", "email"],
				"type": "object"
			},
			"CreateProductInputBody": {
				"additionalProperties": false,
				"properties": {
					"grace_days": {
						"default": 14,
						"format": "int64",
						"maximum": 365,
						"minimum": 0,
						"type": "integer"
					},
					"name": { "maxLength": 64, "minLength": 1, "type": "string" },
					"plan": { "maxLength": 32, "minLength": 1, "type": "string" },
					"prefix": {
						"description": "Uppercase letters and digits. It cannot change later, issued keys are bound to it",
						"maxLength": 16,
						"pattern": "^[A-Z0-9]+$",
						"type": "string"
					},
					"private_key": {
						"description": "Base64 Ed25519 private key of an existing product. A fresh keypair is made when empty",
						"type": "string"
					}
				},
				"required": ["name", "prefix", "plan"],
				"type": "object"
			},
			"ErrorDetail": {
				"additionalProperties": false,
				"properties": {
					"location": {
						"description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
						"type": "string"
					},
					"message": { "description": "Error message text", "type": "string" },
					"value": { "description": "The value at the given location" }
				},
				"type": "object"
			},
			"ErrorModel": {
				"additionalProperties": false,
				"properties": {
					"detail": {
						"description": "A human-readable explanation specific to this occurrence of the problem.",
						"examples": ["Property foo is required but is missing."],
						"type": "string"
					},
					"errors": {
						"description": "Optional list of individual error details",
						"items": { "$ref": "#/components/schemas/ErrorDetail" },
						"type": ["array", "null"]
					},
					"instance": {
						"description": "A URI reference that identifies the specific occurrence of the problem.",
						"examples": ["https://example.com/error-log/abc123"],
						"format": "uri",
						"type": "string"
					},
					"status": {
						"description": "HTTP status code",
						"examples": [400],
						"format": "int64",
						"type": "integer"
					},
					"title": {
						"description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
						"examples": ["Bad Request"],
						"type": "string"
					},
					"type": {
						"default": "about:blank",
						"description": "A URI reference to human-readable documentation for the error.",
						"examples": ["https://example.com/errors/example"],
						"format": "uri",
						"type": "string"
					}
				},
				"type": "object"
			},
			"License": {
				"additionalProperties": false,
				"properties": {
					"created_at": { "format": "date-time", "type": "string" },
					"customer": { "description": "Display name, not part of the key", "type": "string" },
					"email": { "type": "string" },
					"expires_at": {
						"description": "Null for a perpetual license",
						"format": "date-time",
						"type": ["string", "null"]
					},
					"id": {
						"description": "Subscription id at the provider, or lic_... for a manual license",
						"type": "string"
					},
					"key": { "description": "The signed license key", "type": "string" },
					"meta": {
						"additionalProperties": { "type": "string" },
						"description": "Extra claims signed into the key",
						"type": "object"
					},
					"note": { "type": "string" },
					"plan": { "type": "string" },
					"product_id": { "format": "int64", "type": "integer" },
					"renews": {
						"description": "Whether the provider will bill another period",
						"type": "boolean"
					},
					"source": { "enum": ["manual", "stripe"], "type": "string" },
					"status": {
						"description": "Subscription status at the provider, empty for a manual license",
						"type": "string"
					}
				},
				"required": [
					"id",
					"product_id",
					"source",
					"email",
					"customer",
					"plan",
					"expires_at",
					"meta",
					"note",
					"status",
					"renews",
					"key",
					"created_at"
				],
				"type": "object"
			},
			"LicenseFields": {
				"additionalProperties": false,
				"properties": {
					"customer": { "maxLength": 128, "type": "string" },
					"email": { "maxLength": 254, "type": "string" },
					"expires_at": {
						"description": "Leave out for a perpetual license",
						"format": "date-time",
						"type": "string"
					},
					"meta": {
						"additionalProperties": { "type": "string" },
						"description": "Extra claims signed into the key, keep them short",
						"type": "object"
					},
					"note": { "maxLength": 2000, "type": "string" },
					"plan": {
						"description": "Defaults to the product plan",
						"maxLength": 32,
						"type": "string"
					}
				},
				"required": ["email"],
				"type": "object"
			},
			"Product": {
				"additionalProperties": false,
				"properties": {
					"created_at": { "format": "date-time", "type": "string" },
					"grace_days": {
						"description": "Days a provider license stays valid past its paid period",
						"format": "int64",
						"type": "integer"
					},
					"id": { "format": "int64", "type": "integer" },
					"name": { "type": "string" },
					"plan": {
						"description": "Plan claim for provider prices without plan metadata and the default for manual licenses",
						"type": "string"
					},
					"prefix": {
						"description": "Visible key prefix and the app name the product verifies against",
						"type": "string"
					},
					"provider_connected": {
						"description": "Whether an API key and a provider product are stored",
						"type": "boolean"
					},
					"provider_product": {
						"description": "Payment provider product id. Its subscriptions are licenses",
						"type": "string"
					},
					"public_key": {
						"description": "Hex Ed25519 public key to build into the product",
						"type": "string"
					},
					"sync_error": {
						"description": "Why the last provider sync failed, empty when it worked",
						"type": "string"
					},
					"synced_at": {
						"description": "Last successful provider sync",
						"format": "date-time",
						"type": ["string", "null"]
					}
				},
				"required": [
					"id",
					"name",
					"prefix",
					"plan",
					"grace_days",
					"public_key",
					"provider_product",
					"provider_connected",
					"synced_at",
					"sync_error",
					"created_at"
				],
				"type": "object"
			},
			"SyncOutputBody": {
				"additionalProperties": false,
				"properties": {
					"licenses": {
						"description": "License subscriptions found at the provider",
						"format": "int64",
						"type": "integer"
					}
				},
				"required": ["licenses"],
				"type": "object"
			},
			"UpdateProductInputBody": {
				"additionalProperties": false,
				"properties": {
					"grace_days": { "format": "int64", "maximum": 365, "minimum": 0, "type": "integer" },
					"name": { "maxLength": 64, "minLength": 1, "type": "string" },
					"plan": { "maxLength": 32, "minLength": 1, "type": "string" },
					"provider_key": { "description": "Empty keeps the stored key", "type": "string" },
					"provider_product": { "description": "Empty disconnects the provider", "type": "string" }
				},
				"required": ["name", "plan", "grace_days"],
				"type": "object"
			}
		}
	},
	"info": { "title": "Inkan API", "version": "1.0.0" },
	"openapi": "3.1.0",
	"paths": {
		"/api/check": {
			"post": {
				"description": "Verifies a key the way the product would and shows the claims signed into it.",
				"operationId": "check-key",
				"requestBody": {
					"content": {
						"application/json": { "schema": { "$ref": "#/components/schemas/CheckInputBody" } }
					},
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/CheckResult" } }
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Check a license key",
				"tags": ["Licenses"]
			}
		},
		"/api/licenses": {
			"get": {
				"description": "Every license with its key, newest first.",
				"operationId": "list-licenses",
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"items": { "$ref": "#/components/schemas/License" },
									"type": ["array", "null"]
								}
							}
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "List licenses",
				"tags": ["Licenses"]
			},
			"post": {
				"operationId": "create-license",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/CreateLicenseInputBody" }
						}
					},
					"required": true
				},
				"responses": {
					"201": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/License" } }
						},
						"description": "Created"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Issue a manual license",
				"tags": ["Licenses"]
			}
		},
		"/api/products": {
			"get": {
				"operationId": "list-products",
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"items": { "$ref": "#/components/schemas/Product" },
									"type": ["array", "null"]
								}
							}
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "List products",
				"tags": ["Products"]
			},
			"post": {
				"description": "Makes a fresh signing keypair, or takes over the private key of a product that already ships.",
				"operationId": "create-product",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/CreateProductInputBody" }
						}
					},
					"required": true
				},
				"responses": {
					"201": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/Product" } }
						},
						"description": "Created"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Create a product",
				"tags": ["Products"]
			}
		},
		"/api/products/{id}": {
			"delete": {
				"description": "Deletes the signing key and every license of the product.",
				"operationId": "delete-product",
				"parameters": [
					{
						"in": "path",
						"name": "id",
						"required": true,
						"schema": { "format": "int64", "type": "integer" }
					}
				],
				"responses": {
					"204": { "description": "No Content" },
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Delete a product",
				"tags": ["Products"]
			},
			"put": {
				"description": "A connected product is synced with its provider right away, the outcome is on the returned product.",
				"operationId": "update-product",
				"parameters": [
					{
						"in": "path",
						"name": "id",
						"required": true,
						"schema": { "format": "int64", "type": "integer" }
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/UpdateProductInputBody" }
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/Product" } }
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Update a product",
				"tags": ["Products"]
			}
		},
		"/api/products/{id}/sync": {
			"post": {
				"operationId": "sync-product",
				"parameters": [
					{
						"in": "path",
						"name": "id",
						"required": true,
						"schema": { "format": "int64", "type": "integer" }
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/SyncOutputBody" } }
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Sync a product with its provider",
				"tags": ["Products"]
			}
		},
		"/api/products/{product_id}/licenses/{id}": {
			"delete": {
				"description": "Only forgets the license here. A key that is already out keeps working until it expires.",
				"operationId": "delete-license",
				"parameters": [
					{
						"in": "path",
						"name": "product_id",
						"required": true,
						"schema": { "format": "int64", "type": "integer" }
					},
					{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }
				],
				"responses": {
					"204": { "description": "No Content" },
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Delete a manual license",
				"tags": ["Licenses"]
			},
			"put": {
				"description": "Changing a signed field of a manual license changes its key. The provider owns its licenses, only their note is taken.",
				"operationId": "update-license",
				"parameters": [
					{
						"in": "path",
						"name": "product_id",
						"required": true,
						"schema": { "format": "int64", "type": "integer" }
					},
					{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }
				],
				"requestBody": {
					"content": {
						"application/json": { "schema": { "$ref": "#/components/schemas/LicenseFields" } }
					},
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/License" } }
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Update a license",
				"tags": ["Licenses"]
			}
		}
	}
}
