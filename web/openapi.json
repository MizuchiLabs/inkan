{
	"components": {
		"schemas": {
			"CheckInputBody": {
				"additionalProperties": false,
				"properties": { "key": { "maxLength": 4096, "minLength": 1, "type": "string" } },
				"required": ["key"],
				"type": "object"
			},
			"CheckResult": {
				"additionalProperties": false,
				"properties": {
					"email": { "type": "string" },
					"expires_at": {
						"description": "Null for a perpetual key",
						"format": "date-time",
						"type": ["string", "null"]
					},
					"fingerprint": {
						"description": "The machine the key is bound to, empty for a key that works everywhere",
						"type": "string"
					},
					"known": { "description": "Whether the license id is in the ledger", "type": "boolean" },
					"license_id": {
						"description": "Id signed into the key, empty for keys issued without one",
						"type": "string"
					},
					"meta": { "additionalProperties": { "type": "string" }, "type": "object" },
					"plan": { "type": "string" },
					"product_id": {
						"description": "Product the key prefix belongs to, null when unknown",
						"format": "int64",
						"type": ["integer", "null"]
					},
					"reason": { "description": "Why the key is invalid, empty otherwise", "type": "string" },
					"state": { "enum": ["valid", "expired", "invalid"], "type": "string" }
				},
				"required": [
					"state",
					"reason",
					"product_id",
					"license_id",
					"known",
					"plan",
					"email",
					"expires_at",
					"meta",
					"fingerprint"
				],
				"type": "object"
			},
			"CreateLicenseInputBody": {
				"additionalProperties": false,
				"properties": {
					"customer": { "maxLength": 128, "type": "string" },
					"email": { "maxLength": 254, "type": "string" },
					"expires_at": {
						"description": "Leave out for a perpetual license",
						"format": "date-time",
						"type": "string"
					},
					"fingerprint": {
						"description": "Binds the key to one machine. The app says what its fingerprint is, leave it out for a key that works everywhere",
						"maxLength": 128,
						"type": "string"
					},
					"meta": {
						"additionalProperties": { "type": "string" },
						"description": "Extra claims signed into the key, keep them short",
						"type": "object"
					},
					"note": { "maxLength": 2000, "type": "string" },
					"plan": {
						"description": "Defaults to the product plan",
						"maxLength": 32,
						"type": "string"
					},
					"product_id": { "format": "int64", "type": "integer" }
				},
				"required": ["product_id", "email"],
				"type": "object"
			},
			"CreateProductInputBody": {
				"additionalProperties": false,
				"properties": {
					"grace_days": {
						"default": 14,
						"format": "int64",
						"maximum": 365,
						"minimum": 0,
						"type": "integer"
					},
					"max_key_days": { "format": "int64", "maximum": 3650, "minimum": 0, "type": "integer" },
					"name": { "maxLength": 64, "minLength": 1, "type": "string" },
					"plan": { "maxLength": 32, "minLength": 1, "type": "string" },
					"prefix": {
						"description": "Uppercase letters and digits. It cannot change later, issued keys are bound to it",
						"maxLength": 16,
						"pattern": "^[A-Z0-9]+$",
						"type": "string"
					},
					"private_key": {
						"description": "Base64 Ed25519 private key of an existing product. A fresh keypair is made when empty",
						"type": "string"
					}
				},
				"required": ["name", "prefix", "plan"],
				"type": "object"
			},
			"ErrorDetail": {
				"additionalProperties": false,
				"properties": {
					"location": {
						"description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
						"type": "string"
					},
					"message": { "description": "Error message text", "type": "string" },
					"value": { "description": "The value at the given location" }
				},
				"type": "object"
			},
			"ErrorModel": {
				"additionalProperties": false,
				"properties": {
					"detail": {
						"description": "A human-readable explanation specific to this occurrence of the problem.",
						"examples": ["Property foo is required but is missing."],
						"type": "string"
					},
					"errors": {
						"description": "Optional list of individual error details",
						"items": { "$ref": "#/components/schemas/ErrorDetail" },
						"type": ["array", "null"]
					},
					"instance": {
						"description": "A URI reference that identifies the specific occurrence of the problem.",
						"examples": ["https://example.com/error-log/abc123"],
						"format": "uri",
						"type": "string"
					},
					"status": {
						"description": "HTTP status code",
						"examples": [400],
						"format": "int64",
						"type": "integer"
					},
					"title": {
						"description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
						"examples": ["Bad Request"],
						"type": "string"
					},
					"type": {
						"default": "about:blank",
						"description": "A URI reference to human-readable documentation for the error.",
						"examples": ["https://example.com/errors/example"],
						"format": "uri",
						"type": "string"
					}
				},
				"type": "object"
			},
			"License": {
				"additionalProperties": false,
				"properties": {
					"created_at": { "format": "date-time", "type": "string" },
					"customer": { "description": "Display name, not part of the key", "type": "string" },
					"customer_gone": {
						"description": "The customer was deleted at the provider, email and customer are the last known ones",
						"type": "boolean"
					},
					"email": { "type": "string" },
					"expires_at": {
						"description": "Null for a perpetual license",
						"format": "date-time",
						"type": ["string", "null"]
					},
					"fingerprint": {
						"description": "The machine the key is bound to, empty binds to nothing",
						"type": "string"
					},
					"id": {
						"description": "Id at the provider, or lic_... for a manual license",
						"type": "string"
					},
					"key": {
						"description": "The signed license key. A paid license has the one its worker hands out",
						"type": "string"
					},
					"kind": {
						"description": "subscription or purchase at the provider, empty for a manual license",
						"type": "string"
					},
					"meta": {
						"additionalProperties": { "type": "string" },
						"description": "Extra claims signed into the key",
						"type": "object"
					},
					"note": { "type": "string" },
					"plan": { "type": "string" },
					"product_id": { "format": "int64", "type": "integer" },
					"renews": {
						"description": "Whether the provider will bill another period",
						"type": "boolean"
					},
					"source": {
						"description": "manual, or the payment provider the worker reads, like stripe",
						"type": "string"
					},
					"status": {
						"description": "Subscription status at the provider, paid or refunded for a one time purchase, empty for a manual license",
						"type": "string"
					}
				},
				"required": [
					"id",
					"product_id",
					"source",
					"kind",
					"email",
					"customer",
					"customer_gone",
					"plan",
					"expires_at",
					"meta",
					"fingerprint",
					"note",
					"status",
					"renews",
					"key",
					"created_at"
				],
				"type": "object"
			},
			"LicenseFields": {
				"additionalProperties": false,
				"properties": {
					"customer": { "maxLength": 128, "type": "string" },
					"email": { "maxLength": 254, "type": "string" },
					"expires_at": {
						"description": "Leave out for a perpetual license",
						"format": "date-time",
						"type": "string"
					},
					"fingerprint": {
						"description": "Binds the key to one machine. The app says what its fingerprint is, leave it out for a key that works everywhere",
						"maxLength": 128,
						"type": "string"
					},
					"meta": {
						"additionalProperties": { "type": "string" },
						"description": "Extra claims signed into the key, keep them short",
						"type": "object"
					},
					"note": { "maxLength": 2000, "type": "string" },
					"plan": {
						"description": "Defaults to the product plan",
						"maxLength": 32,
						"type": "string"
					}
				},
				"required": ["email"],
				"type": "object"
			},
			"Product": {
				"additionalProperties": false,
				"properties": {
					"created_at": { "format": "date-time", "type": "string" },
					"grace_days": {
						"description": "Worker setting. Days a paid license stays valid past its paid period",
						"format": "int64",
						"type": "integer"
					},
					"id": { "format": "int64", "type": "integer" },
					"mail_accent": {
						"description": "Worker setting. Color of the key mail, #rrggbb",
						"type": "string"
					},
					"mail_company": {
						"description": "Worker setting. Last line of the key mail: legal name, address, register number",
						"type": "string"
					},
					"mail_footer": {
						"description": "Worker setting. One line under the key in the mail",
						"type": "string"
					},
					"mail_from": {
						"description": "Worker setting. Sender of the key mails",
						"type": "string"
					},
					"mail_logo": {
						"description": "Worker setting. https url of a logo for the dark header of the key mail",
						"type": "string"
					},
					"mail_reply_to": {
						"description": "Worker setting. Where an answer to the key mail goes, empty is the sender",
						"type": "string"
					},
					"mail_template": {
						"description": "Worker setting. Html of a key mail of its own with placeholders, empty sends the built-in mail",
						"type": "string"
					},
					"max_key_days": {
						"description": "Worker setting. Longest life of a paid key in days, 0 has no limit. Apps refresh for the next one",
						"format": "int64",
						"type": "integer"
					},
					"name": { "type": "string" },
					"old_public_keys": {
						"description": "Public keys from before a rotation, newest first. The product carries them next to public_key until their keys have run out",
						"items": { "type": "string" },
						"type": "array"
					},
					"plan": {
						"description": "Default for manual licenses. The worker gives it to prices without plan metadata",
						"type": "string"
					},
					"prefix": {
						"description": "Visible key prefix and the app name the product verifies against",
						"type": "string"
					},
					"provider_product": {
						"description": "Worker setting. Stripe product id, its subscriptions and purchases are licenses",
						"type": "string"
					},
					"public_key": {
						"description": "Hex Ed25519 public key to build into the product",
						"type": "string"
					},
					"sync_error": {
						"description": "Why the worker could not be read, or what is off with it. Empty when all is well",
						"type": "string"
					},
					"synced_at": {
						"description": "Last time the worker was read",
						"format": "date-time",
						"type": ["string", "null"]
					},
					"worker_connected": {
						"description": "Whether a worker url is stored",
						"type": "boolean"
					},
					"worker_url": {
						"description": "Where the worker of the product runs. Its paid licenses are mirrored from there",
						"type": "string"
					}
				},
				"required": [
					"id",
					"name",
					"prefix",
					"plan",
					"public_key",
					"old_public_keys",
					"worker_url",
					"worker_connected",
					"grace_days",
					"max_key_days",
					"provider_product",
					"mail_from",
					"mail_reply_to",
					"mail_logo",
					"mail_accent",
					"mail_footer",
					"mail_company",
					"mail_template",
					"synced_at",
					"sync_error",
					"created_at"
				],
				"type": "object"
			},
			"Session": {
				"additionalProperties": false,
				"properties": {
					"protected": { "description": "Whether a password is set", "type": "boolean" },
					"signed_in": {
						"description": "Whether this browser may use the API. Always true without a password",
						"type": "boolean"
					}
				},
				"required": ["protected", "signed_in"],
				"type": "object"
			},
			"SignInInputBody": {
				"additionalProperties": false,
				"properties": { "password": { "maxLength": 1024, "minLength": 1, "type": "string" } },
				"required": ["password"],
				"type": "object"
			},
			"Snapshot": {
				"additionalProperties": false,
				"properties": {
					"active": {
						"description": "Licenses that had not run out",
						"format": "int64",
						"type": "integer"
					},
					"day": { "description": "YYYY-MM-DD in UTC", "type": "string" },
					"plan": { "type": "string" },
					"product_id": { "format": "int64", "type": "integer" }
				},
				"required": ["day", "product_id", "plan", "active"],
				"type": "object"
			},
			"SyncOutputBody": {
				"additionalProperties": false,
				"properties": {
					"licenses": {
						"description": "Paid licenses the worker hands out",
						"format": "int64",
						"type": "integer"
					}
				},
				"required": ["licenses"],
				"type": "object"
			},
			"UpdateProductInputBody": {
				"additionalProperties": false,
				"properties": {
					"grace_days": { "format": "int64", "maximum": 365, "minimum": 0, "type": "integer" },
					"mail_accent": {
						"description": "Color of the key mail, like #2f3e8f",
						"pattern": "^(#[0-9a-fA-F]{6})?$",
						"type": "string"
					},
					"mail_company": {
						"description": "Last line of the key mail, for what a business has to state: legal name, address, register number",
						"maxLength": 512,
						"type": "string"
					},
					"mail_footer": {
						"description": "One line under the key in the mail, like where to get help",
						"maxLength": 256,
						"type": "string"
					},
					"mail_from": {
						"description": "An address or \"Name \u003caddress\u003e\"",
						"maxLength": 256,
						"type": "string"
					},
					"mail_logo": {
						"description": "https url of a logo for the dark header of the key mail",
						"maxLength": 512,
						"pattern": "^(https://.+)?$",
						"type": "string"
					},
					"mail_reply_to": {
						"description": "A bare address for the answers to the key mail, for a sender that reads none",
						"maxLength": 256,
						"pattern": "^([^\\s\u003c\u003e@]+@[^\\s\u003c\u003e@]+)?$",
						"type": "string"
					},
					"mail_template": {
						"description": "Html of a key mail of its own, with {{key}} and the other placeholders in it. Empty sends the built-in mail",
						"maxLength": 262144,
						"type": "string"
					},
					"max_key_days": { "format": "int64", "maximum": 3650, "minimum": 0, "type": "integer" },
					"name": { "maxLength": 64, "minLength": 1, "type": "string" },
					"plan": { "maxLength": 32, "minLength": 1, "type": "string" },
					"provider_product": {
						"description": "Stripe product id for the worker",
						"maxLength": 128,
						"type": "string"
					},
					"worker_url": {
						"description": "Where the worker runs. Empty disconnects it",
						"maxLength": 512,
						"pattern": "^(https?://.+)?$",
						"type": "string"
					}
				},
				"required": ["name", "plan", "grace_days"],
				"type": "object"
			}
		}
	},
	"info": { "title": "Inkan API", "version": "1.0.0" },
	"openapi": "3.1.0",
	"paths": {
		"/api/check": {
			"post": {
				"description": "Verifies a key the way the product would and shows the claims signed into it.",
				"operationId": "check-key",
				"requestBody": {
					"content": {
						"application/json": { "schema": { "$ref": "#/components/schemas/CheckInputBody" } }
					},
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/CheckResult" } }
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Check a license key",
				"tags": ["Licenses"]
			}
		},
		"/api/licenses": {
			"get": {
				"description": "Every license with its key, newest first. Page through a long ledger with limit and offset, a page shorter than the limit is the last one.",
				"operationId": "list-licenses",
				"parameters": [
					{
						"description": "Most licenses to return, 0 returns all of them",
						"explode": false,
						"in": "query",
						"name": "limit",
						"schema": {
							"default": 0,
							"description": "Most licenses to return, 0 returns all of them",
							"format": "int64",
							"maximum": 1000,
							"minimum": 0,
							"type": "integer"
						}
					},
					{
						"description": "How many licenses to skip",
						"explode": false,
						"in": "query",
						"name": "offset",
						"schema": {
							"default": 0,
							"description": "How many licenses to skip",
							"format": "int64",
							"minimum": 0,
							"type": "integer"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"items": { "$ref": "#/components/schemas/License" },
									"type": ["array", "null"]
								}
							}
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "List licenses",
				"tags": ["Licenses"]
			},
			"post": {
				"operationId": "create-license",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/CreateLicenseInputBody" }
						}
					},
					"required": true
				},
				"responses": {
					"201": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/License" } }
						},
						"description": "Created"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Issue a manual license",
				"tags": ["Licenses"]
			}
		},
		"/api/products": {
			"get": {
				"operationId": "list-products",
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"items": { "$ref": "#/components/schemas/Product" },
									"type": ["array", "null"]
								}
							}
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "List products",
				"tags": ["Products"]
			},
			"post": {
				"description": "Makes a fresh signing keypair, or takes over the private key of a product that already ships.",
				"operationId": "create-product",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/CreateProductInputBody" }
						}
					},
					"required": true
				},
				"responses": {
					"201": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/Product" } }
						},
						"description": "Created"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Create a product",
				"tags": ["Products"]
			}
		},
		"/api/products/{id}": {
			"delete": {
				"description": "Deletes the signing key and every license of the product.",
				"operationId": "delete-product",
				"parameters": [
					{
						"in": "path",
						"name": "id",
						"required": true,
						"schema": { "format": "int64", "type": "integer" }
					}
				],
				"responses": {
					"204": { "description": "No Content" },
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Delete a product",
				"tags": ["Products"]
			},
			"put": {
				"description": "A product with a worker is synced with it right away, the outcome is on the returned product. The worker settings only reach the worker once its env is exported and deployed.",
				"operationId": "update-product",
				"parameters": [
					{
						"in": "path",
						"name": "id",
						"required": true,
						"schema": { "format": "int64", "type": "integer" }
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/UpdateProductInputBody" }
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/Product" } }
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Update a product",
				"tags": ["Products"]
			}
		},
		"/api/products/{id}/old-keys": {
			"delete": {
				"description": "For when no key signed before the rotation is still in use. The worker turns such keys down once its env is exported and deployed.",
				"operationId": "drop-old-product-keys",
				"parameters": [
					{
						"in": "path",
						"name": "id",
						"required": true,
						"schema": { "format": "int64", "type": "integer" }
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/Product" } }
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Drop the old public keys of a product",
				"tags": ["Products"]
			}
		},
		"/api/products/{id}/rotate-key": {
			"post": {
				"description": "Makes a fresh keypair and destroys the old private key. Its public half moves to old_public_keys, so keys that are out still verify in a product that carries both. Manual licenses get new keys, the worker signs with the new key once its env is exported and deployed.",
				"operationId": "rotate-product-key",
				"parameters": [
					{
						"in": "path",
						"name": "id",
						"required": true,
						"schema": { "format": "int64", "type": "integer" }
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/Product" } }
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Rotate the signing key of a product",
				"tags": ["Products"]
			}
		},
		"/api/products/{id}/sync": {
			"post": {
				"operationId": "sync-product",
				"parameters": [
					{
						"in": "path",
						"name": "id",
						"required": true,
						"schema": { "format": "int64", "type": "integer" }
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/SyncOutputBody" } }
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Sync a product with its worker",
				"tags": ["Products"]
			}
		},
		"/api/products/{product_id}/licenses/{id}": {
			"delete": {
				"description": "Only forgets the license here. A key that is already out keeps working until it expires.",
				"operationId": "delete-license",
				"parameters": [
					{
						"in": "path",
						"name": "product_id",
						"required": true,
						"schema": { "format": "int64", "type": "integer" }
					},
					{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }
				],
				"responses": {
					"204": { "description": "No Content" },
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Delete a manual license",
				"tags": ["Licenses"]
			},
			"put": {
				"description": "Changing a signed field of a manual license changes its key. The worker owns the paid licenses, only their note is taken.",
				"operationId": "update-license",
				"parameters": [
					{
						"in": "path",
						"name": "product_id",
						"required": true,
						"schema": { "format": "int64", "type": "integer" }
					},
					{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }
				],
				"requestBody": {
					"content": {
						"application/json": { "schema": { "$ref": "#/components/schemas/LicenseFields" } }
					},
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/License" } }
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Update a license",
				"tags": ["Licenses"]
			}
		},
		"/api/session": {
			"delete": {
				"operationId": "sign-out",
				"responses": {
					"204": {
						"description": "No Content",
						"headers": { "Set-Cookie": { "schema": { "type": "string" } } }
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Sign out",
				"tags": ["Session"]
			},
			"get": {
				"operationId": "get-session",
				"parameters": [{ "in": "cookie", "name": "inkan_session", "schema": { "type": "string" } }],
				"responses": {
					"200": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/Session" } }
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Show whether a sign in is needed",
				"tags": ["Session"]
			},
			"post": {
				"description": "Sets the session cookie. Five tries a minute are allowed, for all clients together.",
				"operationId": "sign-in",
				"requestBody": {
					"content": {
						"application/json": { "schema": { "$ref": "#/components/schemas/SignInInputBody" } }
					},
					"required": true
				},
				"responses": {
					"204": {
						"description": "No Content",
						"headers": { "Set-Cookie": { "schema": { "type": "string" } } }
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Sign in with the password",
				"tags": ["Session"]
			}
		},
		"/api/stats": {
			"get": {
				"description": "One entry per day, product and plan, oldest first. A plan without licenses on a day has no entry.",
				"operationId": "list-stats",
				"parameters": [
					{
						"description": "How many days to look back",
						"explode": false,
						"in": "query",
						"name": "days",
						"schema": {
							"default": 90,
							"description": "How many days to look back",
							"format": "int64",
							"maximum": 3650,
							"minimum": 1,
							"type": "integer"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"items": { "$ref": "#/components/schemas/Snapshot" },
									"type": ["array", "null"]
								}
							}
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Show how the license counts moved",
				"tags": ["Licenses"]
			}
		}
	}
