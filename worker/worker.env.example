# The settings of an inkan worker. The keys of the product are not in here,
# they come from inkan worker export as worker.keys.env.
# Quote a value with a space or a # in it.

# Stripe. A restricted key that reads products, subscriptions and customers is
# enough. One time purchases also need Checkout sessions, payment intents and
# charges.
INKAN_STRIPE_KEY=
# The Stripe products that are licenses, comma separated. prod_a=team gives
# the keys of prod_a the plan team, one without a plan gets the plan of the
# product in inkan.
INKAN_STRIPE_PRODUCT=

# Days a key outlives its paid period, so the renewed key arrives in time.
#INKAN_GRACE_DAYS=14
# Longest life of a paid key in days, 0 has no limit.
#INKAN_MAX_KEY_DAYS=0

# Mailing keys. Add a webhook endpoint in Stripe for https://<worker>/webhook
# that sends invoice.paid, checkout.session.completed and
# checkout.session.async_payment_succeeded. Without the secret, a sender and a
# mail service the worker mails nothing and only refreshes.
#INKAN_STRIPE_WEBHOOK_SECRET=whsec_...
#INKAN_MAIL_FROM='My App <licenses@example.com>'
#INKAN_MAIL_REPLY_TO=support@example.com
# One mail service, Resend or Scaleway Transactional Email.
#RESEND_API_KEY=re_...
#INKAN_SCW_SECRET_KEY=
#INKAN_SCW_PROJECT_ID=
#INKAN_SCW_REGION=fr-par

# How the key mail looks, all optional.
#INKAN_MAIL_LOGO=https://example.com/logo.png
#INKAN_MAIL_ACCENT='#2f3e8f'
#INKAN_MAIL_FOOTER='Questions? Just reply to this mail.'
#INKAN_MAIL_COMPANY='Example GmbH, Street 1, 12345 Berlin, HRB 12345'
