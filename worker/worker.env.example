# The settings of an inkan worker. The keys of the product are not in here,
# they come from inkan worker export as worker.keys.env.
# Quote a value with a space or a # in it.

# Stripe. A restricted key that reads products, subscriptions, customers and
# invoices is enough. One time purchases also need Checkout sessions, payment
# intents and charges.
INKAN_STRIPE_KEY=
# The ids of the Stripe products that are licenses, like prod_a,prod_b. What
# their keys say is set in the metadata of each product at Stripe: plan=team,
# meta_tier=gold, days=365. One without a plan gets the plan of the product
# in inkan.
INKAN_STRIPE_PRODUCT=
# 1 reads the subscriptions price by price, for a Stripe account with many
# subscriptions of other products. Only when none of yours was sold with an
# inline price, see STRIPE.md. The Stripe key then also reads Prices.
#INKAN_STRIPE_BY_PRICE=1

# Days a renewal has to get paid. The key of a subscription that renews
# outlives its paid period by that much, so the renewed key arrives in time.
#INKAN_GRACE_DAYS=14
# Days a paid key lives before the app has to refresh, 0 has no limit.
#INKAN_MAX_KEY_DAYS=0

# Mailing keys. Add a webhook endpoint in Stripe for https://<worker>/webhook
# that sends invoice.paid, checkout.session.completed and
# checkout.session.async_payment_succeeded. Without the secret, a sender and a
# mail service the worker mails nothing and only refreshes.
#INKAN_STRIPE_WEBHOOK_SECRET=whsec_...
#INKAN_MAIL_FROM='My App <licenses@example.com>'
#INKAN_MAIL_REPLY_TO=support@example.com
# One mail service, Resend or Scaleway Transactional Email.
#RESEND_API_KEY=re_...
#INKAN_SCW_SECRET_KEY=
#INKAN_SCW_PROJECT_ID=
#INKAN_SCW_REGION=fr-par

# What the key mail says, all optional. For a look of your own see
# inkan worker export --mail.
#INKAN_MAIL_FOOTER='Questions? Just reply to this mail.'
#INKAN_MAIL_COMPANY='Example GmbH, Street 1, 12345 Berlin, HRB 12345'
