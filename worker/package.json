{
	"name": "inkan-worker",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "node src/node.ts",
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"build": "esbuild src/node.ts src/scaleway.ts --bundle --platform=node --format=esm --outdir=dist && echo '{\"type\":\"module\"}' > dist/package.json",
		"check": "tsc",
		"test": "node --test"
	},
	"devDependencies": {
		"@types/node": "^26.6.4",
		"esbuild": "^0.28.2",
		"typescript": "^7.0.2",
		"wrangler": "^4.149.0"
	},
	"packageManager": "pnpm@12.8.2"
}
